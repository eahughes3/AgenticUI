@page "/agentic-chat"
@using AgenticUI.Web.Formatting
@inject LocalAgentConnection Agents
@implements IDisposable

<PageTitle>Agentic Chat</PageTitle>

<div class="scenario">
    <div class="scenario__intro">
        <h1>Agentic chat</h1>
        <p>
            A streaming, multi-turn conversation. The Blazor
            <code>&lt;ChatPage&gt;</code> component talks to an in-process <code>IChatClient</code>.
            Tokens stream directly from the agent,
            then a delegating chat client converts the model's Markdown into structured
            <code>RichTextContent</code> for safe, incremental rendering.
        </p>
    </div>

    <div class="scenario__chat">
        <ChatPage Agent="_agent" Placeholder="Ask me anything…" />
    </div>
</div>

@code {
    private UIAgent _agent = default!;
    private IChatClient _chatClient = default!;

    protected override void OnInitialized()
    {
        _chatClient = new FormattedChatClient(Agents.CreateChatClient(AgentScenario.AgenticChat));
        _agent = new UIAgent(_chatClient, options => options.Thread = new LocalConversationThread());
    }

    public void Dispose()
    {
        _agent.Dispose();
        (_chatClient as IDisposable)?.Dispose();
    }
}
