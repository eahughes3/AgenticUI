@page "/reasoning"
@inject LocalAgentConnection Agents
@implements IDisposable

<PageTitle>Reasoning</PageTitle>

<div class="scenario">
    <div class="scenario__intro">
        <h1>Reasoning</h1>
        <p>
            When the configured model client supplies a reasoning summary as
            <code>TextReasoningContent</code>, the sample maps it directly into a custom activity block
            rendered as a collapsible <em>"reasoning summary"</em> panel, separate from the final answer.
            Try: <em>"A farmer needs to get a fox, a chicken, and a sack of grain across a river. The boat holds the farmer and one item. The fox eats the chicken if left alone with it, and the chicken eats the grain. Work out the full sequence of crossings."</em>
        </p>
        <p class="scenario__note">Note: the current Chat Completions client may not return reasoning
            summaries. Rendering requires a provider that exposes summary content.</p>
    </div>

    <div class="scenario__chat">
        <ChatPage Agent="_agent" Placeholder="Ask a question that needs some thought…">
            <MessageListContent>
                <BlockRenderer TBlock="ReasoningActivityBlock">
                    <details class="sc-ai-reasoning" open="@(context.LifecycleState == BlockLifecycleState.Active)">
                        <summary class="sc-ai-reasoning__header">
                            @(context.LifecycleState == BlockLifecycleState.Active
                                ? "Thinking..."
                                : "Reasoning summary")
                        </summary>
                        <div class="sc-ai-reasoning__content">@context.Text</div>
                    </details>
                </BlockRenderer>
            </MessageListContent>
        </ChatPage>
    </div>
</div>

@code {
    private UIAgent _agent = default!;
    private IChatClient _chatClient = default!;

    protected override void OnInitialized()
    {
        _chatClient = Agents.CreateChatClient(AgentScenario.Reasoning);
        _agent = new UIAgent(
            _chatClient,
            options =>
            {
                options.Thread = new LocalConversationThread();
                options.AddBlockHandler(new ReasoningActivityHandler());
            });
    }

    public void Dispose()
    {
        _agent.Dispose();
        (_chatClient as IDisposable)?.Dispose();
    }
}
