@page "/predictive-state"
@using System.Text.Json
@inject LocalAgentConnection Agents
@inject ILoggerFactory LoggerFactory
@implements IAsyncDisposable

<PageTitle>Predictive State</PageTitle>

<div class="scenario scenario--workspace">
    <div class="scenario__intro">
        <h1>Predictive state</h1>
        <p>
            Collaboratively edit a document, preview the agent's proposed changes, and then
            accept them or restore the previous document.
        </p>
    </div>

    <AgentBoundary Agent="_agent">
        <PredictiveStateWorkspace Agent="_agent" ResetRequested="Reset" />
    </AgentBoundary>
</div>

@code {
    private static readonly JsonSerializerOptions s_jsonOptions =
        new(JsonSerializerDefaults.Web);

    private UIAgent<DocumentState> _agent = default!;
    private IChatClient _chatClient = default!;

    protected override void OnInitialized()
    {
        Reset();
    }

    private UIAgent<DocumentState> CreateAgent(DocumentState initialState)
    {
        var thread = new LocalConversationThread();

        return new UIAgent<DocumentState>(_chatClient, options =>
        {
            options.Thread = thread;
            options.ChatOptions = new ChatOptions
            {
                RawRepresentationFactory = _ => new RunAgentInput
                {
                    ThreadId = thread.ThreadId,
                    State = JsonSerializer.SerializeToElement(
                        _agent.State.Value,
                        s_jsonOptions),
                },
            };
            options.StateMapper = context =>
            {
                var proposal = context.Update.Contents
                    .OfType<FunctionCallContent>()
                    .FirstOrDefault(call => call.Name == "propose_document");
                if (proposal is null)
                {
                    return;
                }

                if (proposal.Arguments?.TryGetValue("document", out var value) != true)
                {
                    throw new InvalidOperationException("The document proposal is missing its document argument.");
                }

                var document = value switch
                {
                    string text => text,
                    JsonElement { ValueKind: JsonValueKind.String } element => element.GetString()
                        ?? throw new InvalidOperationException("The document proposal must contain a string."),
                    _ => throw new InvalidOperationException("The document proposal must contain a string.")
                };
                context.SetPredictiveState(new DocumentState
                {
                    Document = document,
                });
            };
            options.RegisterUIAction(AIFunctionFactory.Create(
                ReviewDocumentProposal,
                name: "propose_document",
                description: "Propose a complete Markdown document for the user to accept or reject."));
        }, LoggerFactory, initialState);
    }

    private string ReviewDocumentProposal(string document, bool? accepted = null)
    {
        var isAccepted = accepted ??
            throw new InvalidOperationException("The document proposal has not been reviewed.");

        if (!_agent.State.HasPendingPredictiveState ||
            _agent.State.Value.Document != document)
        {
            throw new InvalidOperationException("The document proposal is no longer pending.");
        }

        if (isAccepted)
        {
            _agent.State.AcceptPredictiveState();
        }
        else
        {
            _agent.State.RejectPredictiveState();
        }

        return isAccepted
            ? "The user accepted the proposed document. Briefly acknowledge the acceptance and stop."
            : "The user rejected the proposed document. Briefly acknowledge the rejection and stop without proposing another document.";
    }

    private void Reset()
    {
        _agent?.Dispose();
        (_chatClient as IDisposable)?.Dispose();
        _chatClient = Agents.CreateChatClient(AgentScenario.PredictiveState);
        var nextAgent = CreateAgent(new DocumentState());
        _agent = nextAgent;
    }

    public ValueTask DisposeAsync()
    {
        _agent?.Dispose();
        (_chatClient as IDisposable)?.Dispose();
        return ValueTask.CompletedTask;
    }
}
